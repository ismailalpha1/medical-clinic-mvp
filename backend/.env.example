APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
# For SMTP delivery, set MAIL_MAILER=smtp and replace these example values with your provider's settings.
MAIL_SCHEME=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
CLINIC_LEAD_NOTIFICATION_EMAIL=your-inbox@example.com

# Google Calendar OAuth credentials. Keep these values server-side and out of source control.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=

# Booking availability uses ISO weekday numbers (1=Monday, 7=Sunday) and 24-hour local times.
APPOINTMENT_TIMEZONE=
APPOINTMENT_WEEKDAYS=1,2,3,4,5
APPOINTMENT_OPEN_TIME=09:00
APPOINTMENT_CLOSE_TIME=17:00
APPOINTMENT_SLOT_INTERVAL=15
APPOINTMENT_BOOKING_WINDOW_DAYS=60
APPOINTMENT_DURATION_APPOINTMENT=30
APPOINTMENT_DURATION_SERVICES=15
APPOINTMENT_DURATION_LOCATION=15
APPOINTMENT_DURATION_WEBSITE_SOFTWARE=15
APPOINTMENT_DURATION_CALLBACK=15
APPOINTMENT_DURATION_OTHER=30

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
